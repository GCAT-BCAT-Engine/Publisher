{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/publisher-document-artifact-manifest.schema.json",
  "title": "Publisher Document Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generation_id", "document_id", "renderer_version",
    "canonical_document_sha256", "source_export_id", "source_export_sha256",
    "source_verification_root", "artifacts", "validation_state",
    "publication_authorized", "release_authorized", "execution_authorized",
    "authority_effect", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "stegverse.publisher.document-artifact-manifest/v1"},
    "generation_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "document_id": {"type": "string", "minLength": 1},
    "renderer_version": {"type": "string", "minLength": 1},
    "canonical_document_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_export_id": {"type": "string", "minLength": 1},
    "source_export_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_verification_root": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "path", "sha256", "bytes", "validation_state"],
        "properties": {
          "format": {"enum": ["markdown", "html", "pdf", "docx", "json"]},
          "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,132}$"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "validation_state": {"const": "VALIDATED"}
        }
      }
    },
    "validation_state": {"const": "VALIDATED"},
    "publication_authorized": {"const": false},
    "release_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "authority_effect": {"const": "NONE"},
    "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
